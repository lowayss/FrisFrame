{
  "name": "frisframe-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "FrisFrame desktop previs studio",
  "main": "electron/main-entry.cjs",
  "author": "Egoist Film",
  "copyright": "Copyright (c) 2026 Egoist Film",
  "license": "MIT",
  "scripts": {
    "icon:build": "node electron/scripts/build-icon.cjs",
    "vendor:sync": "node electron/scripts/sync-vendor.cjs",
    "server:bundle": "node electron/scripts/build-python-runtime.cjs",
    "runtime:stage": "node electron/scripts/stage-runtime.cjs",
    "desktop:prepare": "npm run icon:build && npm run vendor:sync && npm run server:bundle && npm run runtime:stage",
    "desktop:dev": "npm run vendor:sync && electron .",
    "desktop:dir": "npm run desktop:dir:mac",
    "desktop:build": "npm run desktop:build:mac",
    "desktop:dir:mac": "npm run desktop:prepare && electron-builder --mac dir --arm64",
    "desktop:build:mac": "npm run desktop:prepare && electron-builder --mac dmg zip --arm64",
    "desktop:dir:win": "npm run desktop:prepare && electron-builder --win dir --x64",
    "desktop:build:win": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "desktop:migrate-data": "node electron/scripts/migrate-local-data.cjs",
    "desktop:verify": "node electron/scripts/verify-package.cjs && node electron/scripts/verify-camera-take-mcp.cjs && node electron/scripts/verify-orientation-revision.cjs && node electron/scripts/verify-runtime-source-parity.cjs && node electron/scripts/smoke-package.cjs",
    "check": "python3 quality_check.py && node tests/electron-contract.test.cjs && node tests/birdseye-2-5d-mode-contract.test.cjs && node tests/birdseye-cad-edit-flow-contract.test.cjs && node tests/birdseye-cad-runtime-behavior.test.cjs"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "lucide": "0.468.0",
    "qrcode-generator": "^1.4.4",
    "three": "0.160.0"
  },
  "build": {
    "appId": "studio.frisframe.desktop",
    "productName": "FrisFrame",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/main-entry.cjs",
      "electron/main.cjs",
      "electron/clipboard.cjs",
      "electron/file-save.cjs",
      "electron/preload.cjs",
      "electron/phone-remote-preload.cjs",
      "electron/camera-take-path-core.js",
      "electron/camera-take-replay-ux.js",
      "electron/workspace-ux.js",
      "electron/hud-export-ux.js",
      "electron/interaction-ux.js",
      "electron/camera-operator-live-ux.js",
      "electron/camera-operator-inputs-ux.js",
      "electron/phone-remote.cjs",
      "electron/phone-remote-tls.cjs",
      "electron/phone-motion-server.cjs",
      "electron/phone-motion-core.js",
      "electron/phone-motion-camera-ux.js",
      "electron/camera-take-browser-ux.js",
      "electron/selection-ux.js",
      "electron/alignment-ux.js",
      "electron/history-safety-ux.js",
      "electron/scene-cache-ux.js",
      "electron/dynamic-prop-cache-ux.js",
      "electron/stage-shell-cache-ux.js",
      "electron/camera-path-cache-ux.js",
      "electron/helper-raycast-ux.js",
      "electron/preview-cache-ux.js",
      "electron/performance-ux.js",
      "electron/startup.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-runtime/staged-runtime",
        "to": "runtime"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "licenses/FrisFrame-LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
        "to": "licenses/FFmpeg-LICENSE.txt"
      },
      {
        "from": "node_modules/three/LICENSE",
        "to": "licenses/Three.js-LICENSE.txt"
      },
      {
        "from": "node_modules/lucide/LICENSE",
        "to": "licenses/Lucide-LICENSE.txt"
      }
    ],
    "afterPack": "electron/after-pack.cjs",
    "artifactName": "FrisFrame-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "FrisFrame ${version}",
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 185
        },
        {
          "x": 410,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
